{
  "experiment_name": "femonly-cos2-ref2-512",
  "output_dir": "outputs/stokes_lid",
  "domain": "[-1,1]^2",
  "nu": 1.0,
  "boundary_penalty_epsilon": 1000.0,
  "lid": {
    "type": "smooth",
    "U": 1.0,
    "smooth_profile": "cos2"
  },
  "reference": {
    "method": "fem",
    "checkpoint_path": "",
    "reuse_if_exists": true,
    "fem_mesh_N": 512,
    "fem_order": 2
  },
  "fem_compare": {
    "reference_mesh_N": 512,
    "reference_fem_order": 2,
    "mesh_list": [2, 3, 4, 6, 9, 13, 16, 20, 27]
  },
  "fns": {
    "solver": ["direct_ls"],
    "n_list": [
    ],
    "reluk_k": 3,
    "neuron_sampling": {
      "param_space": "Sd",
      "positive_bias": false,
      "intersection_filter": true,
      "sample_alg": "energy",
      "energy_max_iter": 300,
      "energy_jit": true,
      "energy_seed": 42,
      "energy_cache_dir": ".sphere_cache",
      "energy_force_recompute": false
    },
    "quadrature": {
      "Nx": 200,
      "order": 5,
      "chunk_size": 60000
    },
    "evaluation": {
      "Nx": 500,
      "order": 5,
      "chunk_size": 60000
    },
    "boundary": {
      "quadrature": {
        "Nx": 100,
        "order": 4,
        "chunk_size": 64000
      },
      "evaluation": {
        "Nx": 200,
        "order": 4,
        "chunk_size": 64000
      }
    },
    "linear_solver": {
      "name": "lstsq",
      "lstsq": {
        "rcond": null,
        "lapack_driver": "gelsd",
        "save_svd": true
      }
    }
  },
  "plotting": {
    "make_convergence_figure": true,
    "figure_format": "png",
    "quiver_stride": 16,
    "grid_N": 256
  },
  "overwrite": false
}
